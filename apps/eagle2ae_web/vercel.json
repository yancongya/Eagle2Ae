{
  "installCommand": "npx pnpm@10.12.4 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@10.12.4 run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/ae-preview", "destination": "/index.html" },
    { "source": "/eagle-preview", "destination": "/index.html" },
    { "source": "/download", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/other", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}