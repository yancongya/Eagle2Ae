{
  "enabled": true,
  "logo1Src": "/src/assets/logo.png",
  "logo2Src": "/src/assets/logo2.png",
  "explosionSprites": [
    "/explosion/frag-star.svg",
    "/explosion/frag-ring.svg",
    "/explosion/frag-triangle.svg",
    "/explosion/frag-bolt.svg",
    "/explosion/frag-shard.svg"
  ],
  "explosionDurationMs": 7000,
  "explosionFadeOutMs": 900,
  "baseGravityY": 1.3,
  "drag": {
    "logo1Scale": {
      "mode": "log",
      "distanceDivisor": 200,
      "gain": 0.8,
      "min": 1,
      "max": 2.4
    }
  },
  "animation": {
    "easing": {
      "easeIn": "power2.in",
      "easeOut": "fastOut"
    },
    "return": {
      "durationMinMs": 120,
      "durationMaxMs": 260,
      "distanceNormalizer": 800,
      "distanceCurvePower": 0.5
    },
    "scaleToZero": {
      "durationMs": 180
    }
  },
  "scroll": {
    "deadbandDy": 2,
    "down": {
      "gravityFactor": 0.85,
      "impulseCoeff": 0.0028,
      "impulseMin": 0.0008,
      "impulseMax": 0.010,
      "restoreDurationMs": 700,
      "restoreDelayMs": 60
    },
    "up": {
      "gravityFactor": 1.45,
      "gravityMax": 2.0,
      "durationMs": 200,
      "restoreDurationMs": 800,
      "restoreDelayMs": 50
    }
  },
  "behavior": {
    "forceReloadAfterRelease": true
  }
}